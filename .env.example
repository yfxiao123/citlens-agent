# CiteLens-agent configuration — NOTHING here is required.
#
# This build has no LLM: the agent (Claude / Codex / zcode / DSH / ...) that
# drives the tools is the model. Every source below also runs unauthenticated
# (rate-limited); keys only raise quotas and un-degrade families.

# Web-bridge recall family (Google SERP via serper.dev, free 2500 searches).
# Without it the `web` family is skipped and reported as such.
SERPER_API_KEY=

# Semantic Scholar: free key, raises rate limits for search + recommendations
# + snowball. Without it you share the anonymous ~1 rps pool (occasional 429s
# are expected and reported honestly in the health buckets).
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex: free key (10k credits/day; a works search costs 10 credits).
# Politeness alternative: just set an email and ride the polite pool.
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# Crossref polite pool (free, no key — just an email).
CROSSREF_EMAIL=

# Access layer (optional): proxy/EZproxy for paywalled PDF fetching.
# HTTP_PROXY_FOR_CITELENS=
# EZPROXY_PREFIX=

# Which metadata sources `search` fans out over (comma-separated).
SEARCH_SOURCES=arxiv,semantic_scholar,openalex,crossref
